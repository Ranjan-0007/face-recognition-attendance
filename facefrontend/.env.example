# API URLs for deployment
# For local development, these default to localhost (see src/config/api.js)
# For production, set these to your deployed service URLs

# Node.js backend (Render)
VITE_API_URL=https://your-backend-name.onrender.com

# Python face API (Hugging Face Spaces)
VITE_PYTHON_API_URL=https://your-username-face-api.hf.space
